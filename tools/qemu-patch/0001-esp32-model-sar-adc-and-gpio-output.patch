diff --git a/.qp_after/include/hw/misc/esp32_sens.h b/include/hw/misc/esp32_sens.h
new file mode 100644
index 0000000..6c54f20
--- /dev/null
+++ b/include/hw/misc/esp32_sens.h
@@ -0,0 +1,86 @@
+/*
+ * ESP32 SAR ADC (SENS) emulation
+ *
+ * Copyright (c) 2026 PROJECT_WOWKISPICE contributors
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 or
+ * (at your option) any later version.
+ */
+
+#pragma once
+
+#include "hw/sysbus.h"
+#include "hw/hw.h"
+#include "hw/registerfields.h"
+#include "qemu/timer.h"
+
+#define TYPE_ESP32_SENS "esp32.sens"
+#define ESP32_SENS(obj)             OBJECT_CHECK(Esp32SensState, (obj), TYPE_ESP32_SENS)
+#define ESP32_SENS_GET_CLASS(obj)   OBJECT_GET_CLASS(Esp32SensClass, obj, TYPE_ESP32_SENS)
+#define ESP32_SENS_CLASS(klass)     OBJECT_CLASS_CHECK(Esp32SensClass, klass, TYPE_ESP32_SENS)
+
+/*
+ * Register offsets within the SENS block, transcribed from the ESP-IDF SoC
+ * headers (components/soc/esp32/register/soc/sens_reg.h). Only the handful
+ * the RTC oneshot driver touches are given names; everything else is plain
+ * storage.
+ */
+REG32(SAR_START_FORCE, 0x002c)
+REG32(SAR_ATTEN1,      0x0034)
+REG32(SAR_ATTEN2,      0x0038)
+REG32(SAR_SLAVE_ADDR1, 0x003c)
+REG32(SAR_SLAVE_ADDR2, 0x0040)
+REG32(SAR_I2C_CTRL,    0x0050)
+REG32(SAR_MEAS_START1, 0x0054)
+REG32(SAR_MEAS_START2, 0x0058)
+
+/* Bit fields of SAR_MEAS_START1 / SAR_MEAS_START2. */
+#define SENS_MEAS1_DATA_SAR_MASK    0x0000ffff
+#define SENS_MEAS1_DONE_SAR         (1u << 16)
+#define SENS_MEAS1_START_SAR        (1u << 17)
+#define SENS_MEAS1_START_FORCE      (1u << 18)
+#define SENS_SAR1_EN_PAD_MASK       (0xfffu << 19)
+#define SENS_SAR1_EN_PAD_FORCE      (1u << 31)
+
+/* Control bits we latch; the rest of the register is result, not state. */
+#define SENS_MEAS_START_CTRL_MASK \
+    (SENS_MEAS1_START_SAR | SENS_MEAS1_START_FORCE | \
+     SENS_SAR1_EN_PAD_MASK | SENS_SAR1_EN_PAD_FORCE)
+
+typedef struct Esp32SensState {
+    SysBusDevice parent_obj;
+
+    MemoryRegion iomem;
+    qemu_irq irq;
+
+    /* Latched control bits of SAR_MEAS_START{1,2}. */
+    uint32_t meas_start1;
+    uint32_t meas_start2;
+
+    /* Conversion result, presented to the guest once DONE is set. */
+    uint32_t data1;
+    uint32_t data2;
+    bool done1;
+    bool done2;
+
+    /* Conversion in flight. */
+    QEMUTimer conv_timer;
+    bool conv1_pending;
+    bool conv2_pending;
+
+    /*
+     * Result handed back on the next conversion, and how long a conversion
+     * takes in nanoseconds of guest virtual time. Both are QOM properties so
+     * a co-simulation harness can drive the ADC from outside QEMU with
+     * `qom-set /machine/peripheral/sens adc1-value N` without any firmware
+     * change at all.
+     */
+    uint32_t adc1_value;
+    uint32_t adc2_value;
+    uint32_t conversion_ns;
+} Esp32SensState;
+
+typedef struct Esp32SensClass {
+    SysBusDeviceClass parent_class;
+} Esp32SensClass;
\ No newline at end of file
