diff --git a/.qp_after/hw/misc/esp32_sens.c b/hw/misc/esp32_sens.c
new file mode 100644
index 0000000..dc3179d
--- /dev/null
+++ b/hw/misc/esp32_sens.c
@@ -0,0 +1,198 @@
+/*
+ * ESP32 SAR ADC (SENS) emulation
+ *
+ * Copyright (c) 2026 PROJECT_WOWKISPICE contributors
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 or
+ * (at your option) any later version.
+ *
+ * Espressif's QEMU models the ESP32 SENS block as an `unimplemented-device`,
+ * which decodes MMIO but discards writes. The firmware's control loop polls
+ * SAR_MEAS_START1.MEAS1_DONE_SAR, so with the block unmodelled the guest spins
+ * forever in adc_oneshot_hal_convert() until the interrupt watchdog fires.
+ *
+ * This models just enough of the RTC oneshot path for that loop to run:
+ *
+ *   adc_oneshot_ll_start()          spins on SAR_SLAVE_ADDR1.MEAS_STATUS
+ *                                   until the conversion is idle
+ *   SAR_MEAS_START1.MEAS1_START_SAR rising edge starts a conversion
+ *   MEAS1_DONE_SAR                 set, with MEAS1_DATA_SAR, when it lands
+ *
+ * The sample returned is whatever the `adc1-value` property holds at the
+ * moment the conversion is started, so an external simulator can feed the
+ * analog loop's output voltage in each iteration.
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/timer.h"
+#include "qapi/error.h"
+#include "hw/hw.h"
+#include "hw/sysbus.h"
+#include "hw/registerfields.h"
+#include "hw/irq.h"
+#include "hw/qdev-properties.h"
+#include "hw/misc/esp32_sens.h"
+
+/* ~2-3 us on silicon; comfortably inside the 300 ms interrupt watchdog. */
+#define ESP32_SENS_CONVERSION_NS 5000
+
+static void esp32_sens_convert(void *opaque)
+{
+    Esp32SensState *s = ESP32_SENS(opaque);
+
+    if (s->conv1_pending) {
+        s->conv1_pending = false;
+        s->done1 = true;
+        s->data1 = s->adc1_value & SENS_MEAS1_DATA_SAR_MASK;
+    }
+    if (s->conv2_pending) {
+        s->conv2_pending = false;
+        s->done2 = true;
+        s->data2 = s->adc2_value & SENS_MEAS1_DATA_SAR_MASK;
+    }
+}
+
+static void esp32_sens_start(Esp32SensState *s, bool unit2)
+{
+    if (unit2) {
+        s->done2 = false;
+        s->conv2_pending = true;
+    } else {
+        s->done1 = false;
+        s->conv1_pending = true;
+    }
+    timer_mod(s->conv_timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+                                s->conversion_ns);
+}
+
+static uint64_t esp32_sens_read(void *opaque, hwaddr addr, unsigned int size)
+{
+    Esp32SensState *s = ESP32_SENS(opaque);
+
+    switch (addr) {
+    case A_SAR_MEAS_START1:
+        return (s->meas_start1 & SENS_MEAS_START_CTRL_MASK) |
+               (s->done1 ? SENS_MEAS1_DONE_SAR : 0) |
+               (s->done1 ? s->data1 : 0);
+    case A_SAR_MEAS_START2:
+        return (s->meas_start2 & SENS_MEAS_START_CTRL_MASK) |
+               (s->done2 ? SENS_MEAS1_DONE_SAR : 0) |
+               (s->done2 ? s->data2 : 0);
+    default:
+        /*
+         * Plain storage for the remaining registers. MEAS_STATUS (bits 29:22
+         * of SAR_SLAVE_ADDR1/2) is read-only and must be zero, which is what
+         * lets adc_oneshot_ll_start() fall out of its wait loop.
+         */
+        return 0;
+    }
+}
+
+static void esp32_sens_write(void *opaque, hwaddr addr,
+                             uint64_t value, unsigned int size)
+{
+    Esp32SensState *s = ESP32_SENS(opaque);
+    uint32_t v = (uint32_t)value;
+
+    switch (addr) {
+    case A_SAR_MEAS_START1: {
+        bool was_started = s->meas_start1 & SENS_MEAS1_START_SAR;
+        bool now_started = v & SENS_MEAS1_START_SAR;
+
+        s->meas_start1 = v & SENS_MEAS_START_CTRL_MASK;
+        /* The driver clears then sets the bit, so trigger on the rising edge. */
+        if (!was_started && now_started) {
+            esp32_sens_start(s, false);
+        }
+        break;
+    }
+    case A_SAR_MEAS_START2: {
+        bool was_started = s->meas_start2 & SENS_MEAS1_START_SAR;
+        bool now_started = v & SENS_MEAS1_START_SAR;
+
+        s->meas_start2 = v & SENS_MEAS_START_CTRL_MASK;
+        if (!was_started && now_started) {
+            esp32_sens_start(s, true);
+        }
+        break;
+    }
+    default:
+        /* Remaining registers are write-only or unused by the oneshot path. */
+        break;
+    }
+}
+
+static const MemoryRegionOps esp32_sens_ops = {
+    .read = esp32_sens_read,
+    .write = esp32_sens_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+};
+
+static void esp32_sens_reset_hold(Object *obj, ResetType type)
+{
+    Esp32SensState *s = ESP32_SENS(obj);
+
+    s->meas_start1 = 0;
+    s->meas_start2 = 0;
+    s->data1 = 0;
+    s->data2 = 0;
+    s->done1 = false;
+    s->done2 = false;
+    s->conv1_pending = false;
+    s->conv2_pending = false;
+    timer_del(&s->conv_timer);
+}
+
+static void esp32_sens_realize(DeviceState *dev, Error **errp)
+{
+}
+
+static void esp32_sens_init(Object *obj)
+{
+    Esp32SensState *s = ESP32_SENS(obj);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(obj);
+
+    timer_init_full(&s->conv_timer, QEMU_CLOCK_VIRTUAL, SCALE_NS,
+                    TIMER_VIRTUAL, esp32_sens_convert, s);
+
+    memory_region_init_io(&s->iomem, obj, &esp32_sens_ops, s,
+                          TYPE_ESP32_SENS, 0x400);
+    sysbus_init_mmio(sbd, &s->iomem);
+    sysbus_init_irq(sbd, &s->irq);
+}
+
+static Property esp32_sens_properties[] = {
+    DEFINE_PROP_UINT32("adc1-value", Esp32SensState, adc1_value, 0),
+    DEFINE_PROP_UINT32("adc2-value", Esp32SensState, adc2_value, 0),
+    DEFINE_PROP_UINT32("conversion-ns", Esp32SensState, conversion_ns,
+                       ESP32_SENS_CONVERSION_NS),
+    DEFINE_PROP_END_OF_LIST(),
+};
+
+static void esp32_sens_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    ResettableClass *rc = RESETTABLE_CLASS(klass);
+
+    rc->phases.hold = esp32_sens_reset_hold;
+    dc->realize = esp32_sens_realize;
+    device_class_set_props(dc, esp32_sens_properties);
+}
+
+static const TypeInfo esp32_sens_info = {
+    .name = TYPE_ESP32_SENS,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(Esp32SensState),
+    .instance_init = esp32_sens_init,
+    .class_init = esp32_sens_class_init,
+    .class_size = sizeof(Esp32SensClass),
+};
+
+static void esp32_sens_register_types(void)
+{
+    type_register_static(&esp32_sens_info);
+}
+
+type_init(esp32_sens_register_types)
\ No newline at end of file
