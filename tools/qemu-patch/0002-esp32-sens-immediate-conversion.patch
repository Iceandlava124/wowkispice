diff --git a/hw/misc/esp32_sens.c b/hw/misc/esp32_sens.c
index 179ec91..c4f5cdf 100644
--- a/hw/misc/esp32_sens.c
+++ b/hw/misc/esp32_sens.c
@@ -63,8 +63,11 @@ static void esp32_sens_start(Esp32SensState *s, bool unit2)
         s->done1 = false;
         s->conv1_pending = true;
     }
-    timer_mod(&s->conv_timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
