# ---------------------------------------------------------------------------
# PROJECT_WOWKISPICE - specific notes
# ---------------------------------------------------------------------------
# The ngspice science proofs are distributed as source + a 7z that holds the
# Windows DLLs. The 7z is committed because it is only 4.4 MB, but it is
# encrypted; the real ngspice.dll must be decrypted by the owner and placed at
# tools/ngspice_dll/Spice64_dll/dll-vs/ngspice.dll at build time. No key is
# stored in the repo.
# ---------------------------------------------------------------------------

# Freebuff / CI internal
.freebuff/

# ---------------------------------------------------------------------------
# Checkpoint 2026-10-25: never-commit coverage restored
# ---------------------------------------------------------------------------
# The worktree rewrite dropped patterns HEAD relied on; restored here, plus
# local-only artifacts that must never enter history.
data.dat
config-temp/

# Vendor trees and archives (57 MB + 21 MB + 106 MB locally)
tools/ngspice/
tools/ngspice_dll/
tools/*.zip

# PlatformIO-generated config (overrides sdkconfig.defaults on a fresh clone)
firmware/*/sdkconfig.*
!firmware/*/sdkconfig.defaults

# Third-party downloaded/build artifacts
third_party/

# Third-party reference material (NOT project content).
# docs/ltspice-reference/ holds screenshots of another vendor's application,
# kept locally as a private layout reference only. They are ADI/LTspice's
# copyrighted images and must never be committed or redistributed.
docs/ltspice-reference/
docs/qucs-reference/
