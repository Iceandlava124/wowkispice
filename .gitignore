# Python
__pycache__/
*.py[cod]
*$py.class
*.pyc
.venv/
env/
venv/
ENV/

# Distribution / Packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Simulator Binaries & Large Tools
tools/ngspice/
tools/ngspice_dll/
tools/renode/
tools/*.zip
tools/*.7z
tools/*.tar.gz

# Temporary / IDE / PlatformIO
.pio/
.vscode/
*.log
*.tmp
output/

# PlatformIO's generated sdkconfig. It *overrides* sdkconfig.defaults, so
# committing it silently defeats the checked-in defaults on a fresh clone.
firmware/*/sdkconfig.*
!firmware/*/sdkconfig.defaults

# Editor / agent workspace metadata (not project content)
.freebuff/

# Third-party reference material (NOT project content).
# docs/ltspice-reference/ holds screenshots of another vendor's application, kept
# locally as a private layout reference only. They are ADI/LTspice's copyrighted
# images, so they must never be committed and redistributed in this repo. The UI
# is built from interaction patterns (toolbar placement, hotkeys, pane layout),
# which are not copyrightable expression; the original artwork is ours, drawn as
# QPainterPath at runtime. See docs/systems-map.md "Third-party material".
docs/ltspice-reference/
docs/qucs-reference/
.worktrees/
